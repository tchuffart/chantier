tags: $:/tags/Global
title: $:/plugins/UncleTom/chantier/macros/global
type: text/vnd.tiddlywiki

\define ch-all-intervenants()
[all[tiddlers]tag[intervenant]!has[draft.of]sort[entreprise]]
\end

\define ch-all-lots()
[all[tiddlers]tag[lot]!has[draft.of]sort[title]]
\end

\define ch-all-reunions()
[all[tiddlers]tag[reunion]!has[draft.of]sort[ch-numero]]
\end

\define ch-points-of-reunion(reunion)
[all[tiddlers]tag[point]field:ch-reunion[$reunion$]!has[draft.of]sort[ch-numero]]
\end

\define ch-points-ouverts()
[all[tiddlers]tag[point]!has[draft.of]field:ch-statut[ouvert]sort[ch-numero]]
\end

\define ch-points-pour-rappel()
[all[tiddlers]tag[point]!has[draft.of]field:ch-statut[pour-rappel]sort[ch-numero]]
\end

\define ch-references()
[all[tiddlers]tag[reference]!has[draft.of]sort[ch-categorie]]
\end

\define ch-presences-of-reunion(reunion)
[all[tiddlers]tag[presence]field:ch-reunion[$reunion$]!has[draft.of]]
\end

\define ch-intervenants-table(typeFilter, typeLabel)
<$set name="count" value={{{ [all[tiddlers]tag[intervenant]!has[draft.of]$typeFilter$count[]] }}}>
<$list filter="[<count>compare:number:gt[0]]" variable="ignore">
  <p class="ch-cr-type-header">$typeLabel$</p>
  <table class="lignesmini ch-cr-intervenants">
    <thead><tr>
      <th>Lot</th>
      <th>Entreprise</th>
      <th>Contact</th>
      <th>Rôle</th>
      <th title="Présent">P</th>
      <th title="Excusé">E</th>
      <th title="Absent">A</th>
      <th title="Convoqué">C</th>
    </tr></thead>
    <tbody>
      <$list filter="[all[tiddlers]tag[intervenant]!has[draft.of]$typeFilter$sort[entreprise]]" variable="intervenantTitle">
        <$vars presenceTiddler=<<presenceTid>>>
          <tr>
            <td><$view tiddler=<<intervenantTitle>> field="ch-lot"/></td>
            <td><$view tiddler=<<intervenantTitle>> field="ch-entreprise"/></td>
            <td>
              <$text text=<<intervenantTitle>>/>
              <$list filter="[<intervenantTitle>get[ch-email]!is[blank]]" variable="ignore"><br/><span class="ch-cr-contact-detail"><$view tiddler=<<intervenantTitle>> field="ch-email"/></span></$list>
              <$list filter="[<intervenantTitle>get[ch-tel]!is[blank]]" variable="ignore"><br/><span class="ch-cr-contact-detail"><$view tiddler=<<intervenantTitle>> field="ch-tel"/></span></$list>
            </td>
            <td><$view tiddler=<<intervenantTitle>> field="ch-role"/></td>
            <td class="ch-cr-cell-center"><$list filter="[<presenceTiddler>field:ch-statut[present]]" variable="ignore">✓</$list></td>
            <td class="ch-cr-cell-center"><$list filter="[<presenceTiddler>field:ch-statut[excuse]]" variable="ignore">E</$list></td>
            <td class="ch-cr-cell-center"><$list filter="[<presenceTiddler>field:ch-statut[absent]]" variable="ignore">✗</$list></td>
            <td class="ch-cr-cell-center"><$list filter="[<presenceTiddler>field:ch-convoque[oui]]" variable="ignore">✓</$list></td>
          </tr>
        </$vars>
      </$list>
    </tbody>
  </table>
</$list>
</$set>
\end
