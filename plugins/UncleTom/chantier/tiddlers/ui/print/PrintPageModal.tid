tags: $:/tags/PageTemplate
title: $:/plugins/UncleTom/chantier/ui/print/PrintPageModal
type: text/vnd.tiddlywiki
list-after: $:/core/ui/PageTemplate/story

<$set name="printTiddler" value={{$:/state/chantier/print-reunion-title}}>
<$list filter="[<printTiddler>!is[blank]]" variable="ignore">
  <$set name="previewCRState" value={{{ [<printTiddler>addprefix[$:/state/chantier/preview-cr/]] }}}>
    <$reveal type="match" state=<<previewCRState>> text="open">
      <div class="ch-print-page-modal">
        <div class="ch-modal-a4">
          <div class="ch-modal-toolbar ch-no-print">
            <$button class="ch-btn" message="tm-print">{{$:/core/images/print-button}} Imprimer</$button>
            <$button class="ch-btn">
              <$action-setfield $tiddler=<<previewCRState>> text="closed"/>
              {{$:/core/images/close-button}}
            </$button>
          </div>
          <div class="ch-cr-preview ch-print-target">
            <$tiddler tiddler=<<printTiddler>>>
              {{||$:/plugins/UncleTom/chantier/ui/print/PrintCR}}
            </$tiddler>
          </div>
        </div>
      </div>
    </$reveal>
  </$set>
</$list>
</$set>
