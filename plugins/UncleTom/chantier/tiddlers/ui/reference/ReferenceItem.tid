title: $:/plugins/UncleTom/chantier/ui/reference/ReferenceItem
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/chantier/

<div class="ch-item ch-reference-item">
  <div class="ch-item-actions ch-no-print">
    {{||$:/plugins/UncleTom/chantier/ui/buttons/ReferenceActions}}
  </div>
  <div class="ch-point-header">
    <$list filter="[all[current]has[ch-numero]]" variable="ignore">
      <span class="ch-point-numero"><$view field="ch-numero"/></span>
    </$list>
    <span class="ch-reference-titre"><$link to={{!!title}}><$view field="title"/></$link></span>
  </div>
  <$list filter="[all[current]has[text]!field:text[]]" variable="ignore">
    <div class="ch-point-texte"><$view field="text" format="wikified"/></div>
  </$list>
</div>
