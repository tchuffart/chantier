title: $:/plugins/UncleTom/chantier/ui/reference/ReferenceItem
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/chantier/

<div class="ch-item ch-reference-item">
  <div class="ch-item-actions ch-no-print">
    {{||$:/plugins/UncleTom/chantier/ui/buttons/ReferenceActions}}
  </div>
  <$select tiddler={{!!title}} field="ch-categorie" class="ch-select ch-select-inline ch-no-print">
    <option value="">—</option>
    <$list filter="[all[shadows+tiddlers]tag[$:/plugins/UncleTom/chantier/CategorieReference]sort[ch-label]]" variable="catTid">
      <option value=<<catTid>>><$view tiddler=<<catTid>> field="ch-label"/></option>
    </$list>
  </$select>
  <span class="ch-reference-titre"><$view field="title"/></span>
</div>
