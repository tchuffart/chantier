title: $:/plugins/UncleTom/chantier/ui/buttons/PointActions
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/chantier/

<$button class="ch-btn tc-btn-invisible" tooltip={{$:/language/chantier/Statut/Ouvert}}>
  <$action-setfield $tiddler=<<currentTiddler>> ch-statut="ouvert"/>
  {{$:/core/images/refresh-button}}
</$button>

<$button class="ch-btn tc-btn-invisible" tooltip={{$:/language/chantier/Statut/PourRappel}}>
  <$action-setfield $tiddler=<<currentTiddler>> ch-statut="pour-rappel"/>
  {{$:/core/images/warning}}
</$button>

<$button class="ch-btn tc-btn-invisible" tooltip={{$:/language/chantier/Statut/Resolu}}>
  <$action-setfield $tiddler=<<currentTiddler>> ch-statut="leve" ch-reunion-validation=<<reunionTitle>> ch-date-validation={{{ [<reunionTitle>get[ch-date]] }}}/>
  <$action-listops $tiddler=<<currentTiddler>> $field="tags" $subfilter="+[append[levé]]"/>
  {{$:/core/images/done-button}}
</$button>

<$button class="ch-btn tc-btn-invisible" tooltip={{$:/language/chantier/Edit/Caption}}>
  <$action-sendmessage $message="tm-edit-tiddler" $param=<<currentTiddler>>/>
  {{$:/core/images/edit-button}}
</$button>

<$button class="ch-btn tc-btn-invisible" tooltip={{$:/language/chantier/Delete/Caption}}>
  <$action-deletetiddler $tiddler=<<currentTiddler>>/>
  {{$:/core/images/delete-button}}
</$button>
