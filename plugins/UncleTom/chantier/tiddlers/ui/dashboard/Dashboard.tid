title: $:/plugins/UncleTom/chantier/ui/dashboard/Dashboard
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/chantier/

<div class="ch-dashboard">

  <div class="ch-dashboard-grid">

    <div class="ch-dashboard-card">
      <div class="ch-dashboard-card-count">
        <$count filter=<<ch-all-reunions>>/>
      </div>
      <div class="ch-dashboard-card-label"><<lingo Reunions/Caption>></div>
      <$link to="Réunions" class="ch-dashboard-card-link">
        <<lingo Reunions/Caption>> &raquo;
      </$link>
    </div>

    <div class="ch-dashboard-card">
      <div class="ch-dashboard-card-count">
        <$count filter=<<ch-all-intervenants>>/>
      </div>
      <div class="ch-dashboard-card-label"><<lingo Intervenants/Caption>></div>
      <$link to="Intervenants" class="ch-dashboard-card-link">
        <<lingo Intervenants/Caption>> &raquo;
      </$link>
    </div>

    <div class="ch-dashboard-card">
      <div class="ch-dashboard-card-count">
        <$count filter=<<ch-all-lots>>/>
      </div>
      <div class="ch-dashboard-card-label"><<lingo Lots/Caption>></div>
      <$link to="Lots" class="ch-dashboard-card-link">
        <<lingo Lots/Caption>> &raquo;
      </$link>
    </div>

    <div class="ch-dashboard-card">
      <div class="ch-dashboard-card-count">
        <$count filter=<<ch-references>>/>
      </div>
      <div class="ch-dashboard-card-label"><<lingo References/Caption>></div>
      <$link to="Références" class="ch-dashboard-card-link">
        <<lingo References/Caption>> &raquo;
      </$link>
    </div>

  </div>

  <h3><<lingo PointsOuverts/Caption>></h3>
  <$list filter=<<ch-points-ouverts>>
    template="$:/plugins/UncleTom/chantier/ui/point/PointItem"
    emptyMessage="""<em><<lingo EmptyPointsTitle>></em>"""
  />

  <h3><<lingo PointsPourRappel/Caption>></h3>
  <$list filter=<<ch-points-pour-rappel>>
    template="$:/plugins/UncleTom/chantier/ui/point/PointItem"
    emptyMessage="""<em><<lingo EmptyPointsTitle>></em>"""
  />

</div>
