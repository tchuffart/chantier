\define lingo-base() $:/language/chantier/

<!-- Bandeau projet -->
<$list filter="[[$:/config/UncleTom/chantier/projet]has[ch-nom]!field:ch-nom[]]" variable="ignore">
<div class="ch-projet-bandeau">
  <div class="ch-projet-logos">
    <$list filter="[[$:/plugins/UncleTom/chantier/config/logo-architecte]has[text]]" variable="ignore">
      <$image source="$:/plugins/UncleTom/chantier/config/logo-architecte" height="60"/>
    </$list>
  </div>
  <div class="ch-projet-info">
    <div class="ch-projet-nom">{{$:/config/UncleTom/chantier/projet!!ch-nom}}</div>
    <$list filter="[[$:/config/UncleTom/chantier/projet]has[ch-adresse]!field:ch-adresse[]]" variable="ignore">
      <div class="ch-projet-adresse">{{$:/config/UncleTom/chantier/projet!!ch-adresse}}</div>
    </$list>
    <$list filter="[[$:/config/UncleTom/chantier/projet]has[ch-moa-nom]!field:ch-moa-nom[]]" variable="ignore">
      <div class="ch-projet-moa">MOA : {{$:/config/UncleTom/chantier/projet!!ch-moa-nom}}</div>
    </$list>
  </div>
  <div class="ch-projet-logos">
    <$list filter="[[$:/config/UncleTom/chantier/projet]has[ch-logo-moa]!field:ch-logo-moa[]]" variable="ignore">
      <$image source={{$:/config/UncleTom/chantier/projet!!ch-logo-moa}} height="60"/>
    </$list>
  </div>
</div>
</$list>

<!-- Cartes stats -->
<div class="ch-dashboard-grid">

  <$link to="Réunions" class="ch-dashboard-card">
    <div class="ch-dashboard-card-count"><$count filter=<<ch-all-reunions>>/></div>
    <div class="ch-dashboard-card-label"><<lingo Reunions/Caption>></div>
  </$link>

  <$link to="Intervenants" class="ch-dashboard-card">
    <div class="ch-dashboard-card-count"><$count filter=<<ch-all-intervenants>>/></div>
    <div class="ch-dashboard-card-label"><<lingo Intervenants/Caption>></div>
  </$link>

  <$link to="Lots" class="ch-dashboard-card">
    <div class="ch-dashboard-card-count"><$count filter=<<ch-all-lots>>/></div>
    <div class="ch-dashboard-card-label"><<lingo Lots/Caption>></div>
  </$link>

  <$link to="Références" class="ch-dashboard-card">
    <div class="ch-dashboard-card-count"><$count filter=<<ch-references>>/></div>
    <div class="ch-dashboard-card-label"><<lingo References/Caption>></div>
  </$link>

</div>

<h3><<lingo PointsOuverts/Caption>></h3>
<$list filter=<<ch-points-ouverts>>
  template="$:/plugins/UncleTom/chantier/ui/point/PointItem"
  emptyMessage="""<em><<lingo EmptyPointsTitle>></em>"""
/>

<h3><<lingo PointsPourRappel/Caption>></h3>
<$list filter=<<ch-points-pour-rappel>>
  template="$:/plugins/UncleTom/chantier/ui/point/PointItem"
  emptyMessage="""<em><<lingo EmptyPointsTitle>></em>"""
/>
