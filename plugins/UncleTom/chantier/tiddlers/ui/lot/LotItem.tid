\define lingo-base() $:/language/chantier/

<div class="ch-item ch-lot-item">
  <div class="ch-item-actions">
    {{||$:/plugins/UncleTom/chantier/ui/buttons/LotActions}}
  </div>
  <span class="ch-lot-titre"><$link to={{!!title}}><$view field="title"/></$link></span>
  <$list filter="[all[current]has[ch-societe]]">
    <span class="ch-lot-entreprise"> — <$view field="ch-societe"/></span>
  </$list>
</div>
