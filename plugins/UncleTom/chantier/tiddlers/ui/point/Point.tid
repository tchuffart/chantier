tags: $:/tags/ViewTemplate
title: $:/plugins/UncleTom/chantier/ui/point/Point
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/chantier/

<$list filter="[all[current]tag[point]]" variable="ignore">
  <div class="ch-point-view">
    <div class="ch-point-view-header">
      <span class="ch-point-numero"><$view field="ch-numero"/></span>
      <span class="ch-point-statut ch-point-statut-<$view field="ch-statut"/>">
        <<lingo Statut/Caption>>
      </span>
    </div>
    <$list filter="[all[current]has[ch-lots]]">
      <div class="ch-point-view-lots">
        <strong><<lingo Lots/Caption>> :</strong> <$view field="ch-lots"/>
      </div>
    </$list>
    <$list filter="[all[current]has[ch-responsables]]">
      <div class="ch-point-view-responsables">
        <strong><<lingo Responsables/Placeholder>> :</strong> <$view field="ch-responsables"/>
      </div>
    </$list>
    <$list filter="[all[current]has[ch-echeance]]">
      <div class="ch-point-view-echeance">
        <strong><<lingo Echeance/Caption>> :</strong> <$view field="ch-echeance"/>
      </div>
    </$list>
  </div>
</$list>
