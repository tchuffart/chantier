title: $:/plugins/UncleTom/chantier/ui/point/PointItem
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/chantier/

<div class={{{ [all[current]get[ch-statut]addprefix[ch-item ch-point ch-point-]] }}}>
  <div class="ch-item-actions ch-no-print">
    <$list filter="[all[current]field:ch-statut[ouvert]] [all[current]field:ch-statut[pour-rappel]] +[limit[1]]" variable="ignore">
      <$button class="ch-btn-valider ch-no-print" tooltip="Valider ce point">
        <$action-setfield ch-statut="resolu" ch-reunion-validation=<<reunionTitle>> ch-date-validation={{{ [<reunionTitle>get[ch-date]] }}}/>
        <$action-listops $field="tags" $subfilter="+[append[résolu]]"/>
        ✓
      </$button>
    </$list>
    {{||$:/plugins/UncleTom/chantier/ui/buttons/PointActions}}
  </div>
  <div class="ch-point-body">
    <div class="ch-point-main">
      <div class="ch-point-header">
        <span class="ch-point-numero"><$view field="ch-numero"/></span>
        <span class="ch-point-titre"><$link to={{!!title}}><$view field="title"/></$link></span>
      </div>
      <$list filter="[all[current]has[text]!field:text[]]" variable="ignore">
        <div class="ch-point-texte"><$view field="text" format="wikified"/></div>
      </$list>
    </div>
    <div class="ch-point-meta">
      <$set name="statut" value={{!!ch-statut}}>
        <span class={{{ [<statut>addprefix[ch-point-statut-badge ch-point-statut-]] }}}>
          <$list filter="[<statut>match[ouvert]]" variable="ignore">Ouvert</$list>
          <$list filter="[<statut>match[pour-rappel]]" variable="ignore">Pour rappel</$list>
          <$list filter="[<statut>match[resolu]]" variable="ignore">Résolu</$list>
        </span>
      </$set>
      <$list filter="[all[current]has[ch-echeance]]" variable="ignore">
        <div class="ch-point-meta-row"><span class="ch-point-meta-label">Échéance</span> <$view field="ch-echeance"/></div>
      </$list>
      <$list filter="[all[current]has[ch-responsables]]" variable="ignore">
        <div class="ch-point-meta-row"><span class="ch-point-meta-label">Responsable</span> <$view field="ch-responsables"/></div>
      </$list>
      <$list filter="[all[current]field:ch-statut[resolu]has[ch-date-validation]]" variable="ignore">
        <div class="ch-point-meta-row"><span class="ch-point-meta-label">Résolu le</span> <$view field="ch-date-validation"/></div>
      </$list>
    </div>
  </div>
</div>
