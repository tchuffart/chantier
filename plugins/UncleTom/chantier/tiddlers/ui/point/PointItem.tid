title: $:/plugins/UncleTom/chantier/ui/point/PointItem
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/chantier/

<div class={{{ [all[current]get[ch-statut]addprefix[ch-point ch-point-]] }}}>
  <div class="ch-item-actions ch-no-print">
    {{||$:/plugins/UncleTom/chantier/ui/buttons/PointActions}}
  </div>
  <span class="ch-point-numero"><$view field="ch-numero"/></span>
  <$view field="title"/>
  <$list filter="[all[current]has[ch-echeance]]">
    <span class="ch-point-echeance"> — <<lingo Echeance/Caption>> : <$view field="ch-echeance"/></span>
  </$list>
  <$list filter="[all[current]has[ch-responsables]]">
    <span class="ch-point-responsables"> (<$view field="ch-responsables"/>)</span>
  </$list>
</div>
