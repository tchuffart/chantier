modified: 20260605000000000
title: $:/plugins/UncleTom/chantier/ui/point/Points
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/chantier/
\define addPointState() $:/state/chantier/add-point/$(currentTiddler)$
\define previewCRState() $:/state/chantier/preview-cr/$(currentTiddler)$
\define addRefReunionState() $:/state/chantier/add-reference-reunion/$(currentTiddler)$

<$set name="thisNumero" value={{!!ch-numero}}>
<$vars reunionTitle=<<currentTiddler>>>

<h3><<lingo PointsReportes/Caption>></h3>
<$list filter="[all[tiddlers]tag[point]!has[draft.of]field:ch-statut[ouvert]] [all[tiddlers]tag[point]!has[draft.of]field:ch-statut[pour-rappel]] [all[tiddlers]tag[point]!has[draft.of]field:ch-statut[resolu]field:ch-reunion-validation<reunionTitle>] +[sort[ch-numero]]" variable="pt" emptyMessage="">
  <$set name="ptReunionNumero" value={{{ [<pt>get[ch-reunion-creation]get[ch-numero]] }}}>
    <$list filter="[<ptReunionNumero>compare:number:lt<thisNumero>]" variable="ignore" emptyMessage="">
      <$list filter="[<pt>]" template="$:/plugins/UncleTom/chantier/ui/point/PointItem"/>
    </$list>
  </$set>
</$list>

<h3><<lingo PointsNouveaux/Caption>></h3>
<$list filter="[all[tiddlers]tag[point]!has[draft.of]field:ch-reunion-creation{!!title}sort[ch-numero]]"
  template="$:/plugins/UncleTom/chantier/ui/point/PointItem"
  emptyMessage="""<em><<lingo EmptyPointsTitle>></em>"""
/>

<div class="ch-toolbar ch-no-print">
  <$list filter="[all[shadows+tiddlers]tag[$:/plugins/UncleTom/chantier/ReunionTools]!has[draft.of]sort[list]]" variable="toolTitle">
    <$transclude tiddler=<<toolTitle>>/>
  </$list>
</div>

<$reveal type="match" state=<<addPointState>> text="open">
  {{||$:/plugins/UncleTom/chantier/ui/forms/AddPoint}}
</$reveal>

<$reveal type="match" state=<<addRefReunionState>> text="open">
  {{||$:/plugins/UncleTom/chantier/ui/forms/AddReferenceInReunion}}
</$reveal>

<$reveal type="match" state=<<previewCRState>> text="open">
  <div class="ch-modal-overlay">
    <div class="ch-modal-a4">
      <div class="ch-modal-toolbar ch-no-print">
        <$button class="ch-btn" message="tm-print">{{$:/core/images/print-button}} Imprimer</$button>
        <$button class="ch-btn">
          <$action-setfield $tiddler=<<previewCRState>> text="closed"/>
          {{$:/core/images/close-button}}
        </$button>
      </div>
      <div class="ch-cr-preview ch-print-target">
        {{||$:/plugins/UncleTom/chantier/ui/print/PrintCR}}
      </div>
    </div>
  </div>
</$reveal>

</$vars>
</$set>
