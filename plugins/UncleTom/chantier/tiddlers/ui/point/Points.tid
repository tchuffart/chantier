title: $:/plugins/UncleTom/chantier/ui/point/Points
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/chantier/
\define ch-points-reportes() [all[tiddlers]tag[point]!has[draft.of]field:ch-statut[ouvert]!field:ch-reunion-creation{!!title}sort[ch-numero]] [all[tiddlers]tag[point]!has[draft.of]field:ch-statut[pour-rappel]sort[ch-numero]]
\define ch-points-nouveaux() [all[tiddlers]tag[point]!has[draft.of]field:ch-reunion-creation{!!title}sort[ch-numero]]
\define addPointState() $:/state/chantier/add-point/$(currentTiddler)$

<h3><<lingo PointsReportes/Caption>></h3>
<$list filter=<<ch-points-reportes>>
  template="$:/plugins/UncleTom/chantier/ui/point/PointItem"
  emptyMessage="""<em><<lingo EmptyPointsReportesTitle>></em>"""
/>

<h3><<lingo PointsNouveaux/Caption>></h3>
<$list filter=<<ch-points-nouveaux>>
  template="$:/plugins/UncleTom/chantier/ui/point/PointItem"
  emptyMessage="""<em><<lingo EmptyPointsTitle>></em>"""
/>

<div class="ch-toolbar">
  <$button class="ch-btn-tool" tooltip={{$:/language/chantier/AddPoint/Hint}}>
    <$action-setfield $tiddler=<<addPointState>> text={{{ [<addPointState>get[text]match[open]then[closed]else[open]] }}}/>
    {{$:/core/images/new-button}}
    <<lingo AddPoint/Caption>>
  </$button>
  <$list filter="[all[tiddlers]tag[$:/plugins/UncleTom/chantier/ReunionTools]!has[draft.of]sort[list]]" variable="toolTitle">
    <$transclude tiddler=<<toolTitle>>/>
  </$list>
</div>

<$reveal type="match" state=<<addPointState>> text="open">
  {{||$:/plugins/UncleTom/chantier/ui/forms/AddPoint}}
</$reveal>
