title: $:/plugins/UncleTom/chantier/ui/forms/AddReference
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/chantier/

\define add-reference-actions()
  <$action-createtiddler
    $basetitle={{{ [<stateTiddler>get[titre]] }}}
    $savetitle="$:/state/chantier/new-reference"
    tags="reference"
    ch-categorie={{{ [<stateTiddler>get[categorie]] }}}
    ch-statut="reference"
  />
  <$action-setfield $tiddler=<<stateTiddler>> titre="" categorie=""/>
\end

<$vars stateTiddler=<<qualify "$:/temp/chantier/reference-form">>>
  <div class="ch-form">
    <$keyboard key="Enter" actions=<<add-reference-actions>>>
      <$edit-text tiddler=<<stateTiddler>> field="titre"
        placeholder={{$:/language/chantier/AddReferenceToChantier/Placeholder}}
        class="ch-input"
      />
    </$keyboard>
    <$select tiddler=<<stateTiddler>> field="categorie" class="ch-select">
      <option value=""><<lingo Categorie/Caption>></option>
      <option value="reglementation"><<lingo Categorie/Reglementation>></option>
      <option value="materiau"><<lingo Categorie/Materiau>></option>
      <option value="securite"><<lingo Categorie/Securite>></option>
      <option value="altimetrie"><<lingo Categorie/Altimetrie>></option>
      <option value="acces"><<lingo Categorie/Acces>></option>
      <option value="choix-produit"><<lingo Categorie/ChoixProduit>></option>
    </$select>
    <$button actions=<<add-reference-actions>> class="ch-btn-primary">
      <<lingo AddReference/Caption>>
    </$button>
  </div>
</$vars>
