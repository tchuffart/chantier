title: $:/plugins/UncleTom/chantier/ui/intervenant/IntervenantItem
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/chantier/

<div class="ch-item ch-intervenant-item">
  <div class="ch-item-actions">
    {{||$:/plugins/UncleTom/chantier/ui/buttons/IntervenantActions}}
  </div>
  <span class="ch-intervenant-nom"><$link to={{!!title}}><$view field="title"/></$link></span>
  <$list filter="[all[current]has[ch-societe]]">
    <span class="ch-intervenant-entreprise"> — <$view field="ch-societe"/></span>
  </$list>
  <$list filter="[all[current]has[ch-role]]">
    <span class="ch-intervenant-role"> (<$view field="ch-role"/>)</span>
  </$list>
  <$list filter="[all[current]has[ch-type]]">
    <$set name="chType" value={{!!ch-type}}>
      <span class="ch-intervenant-type"> — <$list filter="[<chType>match[moa]]" variable="ignore">Maîtrise d'ouvrage</$list><$list filter="[<chType>match[moe]]" variable="ignore">Maîtrise d'œuvre</$list><$list filter="[<chType>match[entreprise]]" variable="ignore">Entreprise</$list></span>
    </$set>
  </$list>
</div>
