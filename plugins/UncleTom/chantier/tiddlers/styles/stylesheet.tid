\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

.ch-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1em;
}

.ch-heading h2 {
  margin: 0;
}

.ch-list {
  padding-left: 0;
  list-style: none;
}

.ch-item {
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  padding: 6px 0;
}

.ch-item:first-child {
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.ch-item-actions {
  float: right;
}

.ch-item-actions .ch-btn {
  color: #999;
  fill: #999;
  padding: 2px 4px;
  border-radius: 4px;
  font-size: .8em;
  margin-left: 4px;
}

@media (min-width: {{$:/themes/tiddlywiki/vanilla/metrics/sidebarbreakpoint}}) {
  .ch-item-actions .ch-btn {
    opacity: 0;
    transition: opacity ease-in .14s;
  }

  .ch-item:hover .ch-item-actions .ch-btn {
    opacity: 1;
  }
}

/* Points */
.ch-point {
  padding: 6px 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

.ch-point:first-child {
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.ch-point-numero {
  font-weight: bold;
  color: <<colour primary>>;
  margin-right: 6px;
}

.ch-point-pour-rappel .ch-point-numero {
  color: #e73939;
}

.ch-point-pour-rappel {
  background: rgba(231, 57, 57, 0.05);
  padding: 6px 4px;
  border-left: 3px solid #e73939;
}

.ch-point-reference {
  background: rgba(45, 165, 98, 0.05);
  padding: 6px 4px;
  border-left: 3px solid #2da562;
}

.ch-point-resolu {
  opacity: 0.6;
}

.ch-point-resolu .ch-point-numero {
  color: #2da562;
}

/* Dashboard */
.ch-dashboard-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 1em;
  margin-bottom: 2em;
}

.ch-dashboard-card {
  border: 1px solid rgba(0,0,0,0.1);
  border-radius: 8px;
  padding: 1em;
  text-align: center;
  background: rgba(0,0,0,0.02);
}

.ch-dashboard-card-count {
  font-size: 2.4em;
  font-weight: bold;
  color: <<colour primary>>;
  line-height: 1.1;
}

.ch-dashboard-card-label {
  font-size: .85em;
  color: #888;
  margin: 4px 0 8px;
}

.ch-dashboard-card-link {
  font-size: .8em;
}

/* Tableau des présences */
.ch-presences-table {
  width: 100%;
  border-collapse: collapse;
  font-size: .9em;
}

.ch-presences-table th,
.ch-presences-table td {
  border: 1px solid rgba(0,0,0,0.1);
  padding: 4px 8px;
  text-align: center;
}

.ch-presences-table th {
  background: rgba(0,0,0,0.04);
  font-weight: bold;
}

.ch-presences-table td:first-child {
  text-align: left;
}

.ch-present { color: #2da562; font-weight: bold; }
.ch-excuse  { color: #e77a39; font-weight: bold; }
.ch-absent  { color: #ccc; }

.ch-btn-presence {
  min-width: 28px;
  padding: 2px 6px;
  border-radius: 4px;
  font-weight: bold;
  font-size: .85em;
  color: #bbb;
  border: 1px solid transparent;
}

.ch-btn-presence.ch-btn-active {
  color: #fff;
  background: <<colour primary>>;
  border-color: <<colour primary>>;
}

/* Impression */
@media print {
  .ch-no-print { display: none !important; }

  .ch-print-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #333;
    padding-bottom: 10px;
    margin-bottom: 20px;
  }

  .ch-print-header img {
    max-height: 60px;
  }

  .ch-print-header .ch-print-title {
    text-align: center;
    font-size: 1.2em;
    font-weight: bold;
  }

  .ch-point-pour-rappel {
    border-left: 3px solid #e73939;
    page-break-inside: avoid;
  }
}
