+                <td><$view field="ch-numero"/></td>
+                <td><$view field="title"/></td>
+                <td><$view field="ch-reunion-creation"/></td>
+              </tr>
+            </$list>
+          </tbody>
+        </table>
+      </$list>
+    </$set>
+  </$list>
+
+  <!-- Sans catégorie -->
+  <$set name="refsNoCat" value={{{ [all[tiddlers]tag[reference]!has[draft.of]!has[ch-categorie]count[]] }}}>
+    <$list filter="[<refsNoCat>compare:number:gt[0]]" variable="ignore">
+      <h2 class="ch-cr-section">Sans catégorie</h2>
+      <table class="lignes">
+        <thead>
+          <tr><th style="width:6em">N°</th><th>Référence</th><th style="width:10em">Réunion</th></tr>
+        </thead>
+        <tbody>
+          <$list filter="[all[tiddlers]tag[reference]!has[draft.of]!has[ch-categorie]sort[title]]">
+            <tr>
+              <td><$view field="ch-numero"/></td>
+              <td><$view field="title"/></td>
+              <td><$view field="ch-reunion-creation"/></td>
+            </tr>
+          </$list>
+        </tbody>
+      </table>
+    </$list>
+  </$set>
+
+</div>
